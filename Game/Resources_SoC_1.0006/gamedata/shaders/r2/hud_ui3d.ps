// 3D models in UI: the tile is premultiplied (colour already multiplied by coverage); the static's colour tints it and its alpha fades it.
// The outline (CUIModel::SetOutline, per draw: ui3d_outline_*) is drawn behind the model from the page's mask (distance to the silhouette)
uniform float4 ui3d_outline; // premultiplied colour (alpha: strength)
uniform float4 ui3d_outline_params; // x: width (pixels, 0: none), y: softness (pixels), z: mask range

sampler2D s_base;
sampler2D s_mask;

struct v2p
{
	float4 c0 : COLOR0;
	float2 tc0 : TEXCOORD0;
};

float4 main(v2p I) : COLOR
{
	float4 t = tex2D(s_base, I.tc0);
	float4 o = float4(t.rgb * I.c0.rgb, t.a);

	float d = tex2D(s_mask, I.tc0).r * ui3d_outline_params.z;
	float soft = max(ui3d_outline_params.y, 1.f);
	// full up to the width, falling off over the softness around it; nothing past the mask range or without an outline
	float a = saturate((ui3d_outline_params.x - d) / soft + 0.5f) * (d < ui3d_outline_params.z ? 1.f : 0.f) * (ui3d_outline_params.x > 0.f ? 1.f : 0.f);
	o += ui3d_outline * a * (1.f - o.a);
	return o * I.c0.a;
}
