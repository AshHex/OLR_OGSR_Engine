-- Меню расширенных настроек графики для OGSR Engine.
-- Как в оригинальных Тенях Чернобыля: у каждого рендера свой набор настроек, настройки, которых нет у рендера,
-- выбранного на вкладке "Видео" (тип рендера), отображаются, но недоступны. Выбор рендера применяется после перезапуска.

local hint_colors = {
	["green"] = {255, 0, 128, 0},
	["yellow"] = {255, 186, 149, 0},
	["red"] = {255, 255, 0, 0},
	["blue"] = {255, 0, 255, 255},
	["white"] = {255, 215, 195, 170},
}
local disabled_color = {255, 110, 104, 96}

-- Возможности рендеров (по токенам консольной команды renderer)
--   r1     - статическое освещение (DX9)
--   r2     - любое динамическое освещение (R2/R2a/R2.5/R3/R4)
--   dx9r2  - динамическое освещение DX9 (R2a/R2/R2.5): старые SSAO, мягкая вода и частицы
--   sun    - динамическое солнце (нет на R2a - "Динам. освещение объектов")
--   advpp  - расширенный постпроцесс (R2.5/R3/R4): солнечные лучи
--   dx10   - DX10/DX11 (R3/R4): MSAA, намокание поверхностей, объёмный дым
--   r3     - только R3 (DX10)
--   r4     - только R4 (DX11): тесселяция, SSR, параллакс земли, DOF оружия
local renderer_features = {
	["renderer_r1"]   = {r1 = true},
	["renderer_r2a"]  = {r2 = true, dx9r2 = true},
	["renderer_r2"]   = {r2 = true, dx9r2 = true, sun = true},
	["renderer_r2.5"] = {r2 = true, dx9r2 = true, sun = true, advpp = true},
	["renderer_r3"]   = {r2 = true, sun = true, advpp = true, dx10 = true, r3 = true},
	["renderer_r4"]   = {r2 = true, sun = true, advpp = true, dx10 = true, r4 = true},
}

