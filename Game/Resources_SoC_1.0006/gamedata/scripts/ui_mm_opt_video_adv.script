local control_init_funs = {
	["track"] = "InitTrackBar",
	["list"] = "InitComboBox",
	["check"] = "InitCheck",
}

local function available(avail, features)
	if not avail or avail == "all" then
		return true
	end
	for f in string.gmatch(avail, "%S+") do
		if features[f] then
			return true
		end
	end
	return false
end

-- Токен рендера, выбранный в комбобоксе вкладки "Видео" (если комбобокса нет - текущий рендер)
function selected_renderer_token(combo)
	if combo then
		local text = combo:GetText()
		for _, token in ipairs({"renderer_r1", "renderer_r2a", "renderer_r2", "renderer_r2.5", "renderer_r3", "renderer_r4"}) do
			if game.translate_string(token) == text then
				return token
			end
		end
	end
	return get_console():get_token("renderer")
end

class "opt_video_adv" (CUIWindow)
function opt_video_adv:__init() super()
	self.items = {}
	self.order = {} -- имена опций по порядку (обход через ipairs)
end

function opt_video_adv:__finalize()
end

function opt_video_adv:InitControls(x, y, xml, handler)
	self:Init(x, y, 738, 416)
	self:SetAutoDelete(true)

	xml:InitFrame("frame", self)
	self.scroll_v = xml:InitScrollView("video_adv:scroll_v", self)

	-- перебираем с конца, поскольку в настройках scroll view в xml стоит параметр flip_vert="1",
	-- который инвертирует порядок элементов, что в свою очередь сделано для того, чтобы визуально первые элементы
	-- добавлялись последними, что в свою очередь позволяет раскрывающимся спискам перекрывать элементы, расположенные ниже по списку
	for i = #adv_vid_opt_params, 1, -1 do
		local opt, ctr_type, need_restart, color, hint_caption, hint_string, avail = unpack(adv_vid_opt_params[i])

		local _st = xml:InitStatic("video_adv:templ_item", self.scroll_v)
		local _st2 = xml:InitStatic("video_adv:cap_"..opt, _st)
		local ctl = xml[control_init_funs[ctr_type]](xml, "video_adv:"..ctr_type.."_"..opt, _st)

		local item = {st = _st, cap = _st2, ctl = ctl, color = color, avail = avail, enabled = true}
		self.items[opt] = item
		table.insert(self.order, opt)

		handler:Register(_st, "video_adv_cap_"..opt)
		handler:AddCallback(
			"video_adv_cap_"..opt,
			ui_events.STATIC_FOCUS_RECEIVED,
			function()
				handler.hint_name:SetText(hint_caption and hint_caption ~= "" and game.translate_string(hint_caption) or "")
				if item.enabled then
					handler.hint_caption:SetText(hint_string and hint_string ~= "" and game.translate_string(hint_string) or "")
				else
					handler.hint_caption:SetText(game.translate_string("video_settings_unavailable"))
				end
			end
			)

		if need_restart == 1 then
			handler:Register(ctl, "video_adv:"..ctr_type.."_"..opt)
			handler:AddCallback(
				"video_adv:"..ctr_type.."_"..opt,
				ctr_type == "list" and ui_events.LIST_ITEM_SELECT or ui_events.BUTTON_CLICKED,
				handler.show_need_restart_wnd, handler
			)
		end
	end

	local btn = xml:Init3tButton("video_adv:btn_to_simply", self)
	handler:Register(btn, "btn_simply_graphic")
end

-- Доступность настроек для рендера (токен консольной команды renderer)
function opt_video_adv:UpdateAvailability(token)
	local features = renderer_features[token] or renderer_features["renderer_r4"]
	for _, opt in ipairs(self.order) do
		local item = self.items[opt]
		local en = available(item.avail, features)
		item.enabled = en
		item.st:Enable(en)
		item.cap:Enable(en)
		item.ctl:Enable(en)
		item.cap:SetTextColor(unpack(en and item.color or disabled_color))
	end
end
